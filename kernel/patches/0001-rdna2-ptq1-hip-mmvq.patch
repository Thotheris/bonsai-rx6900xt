new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-ptq1_0-hip.cuh
@@ -0,0 +1,68 @@
+#pragma once
+// Included by mmvq.cu after vecdotq.cuh. HIP only. Columns 1-4 only.
+// Same element map as vec_dot_ptq1_0_q8_1. qh is four trits per byte, not five.
+
+static __device__ __forceinline__ int ptq1_0_pack_trits(const uint32_t w0, const uint32_t w1) {
+    // Gather four base-3 digits, then map 0/1/2 to signed -1/0/1 bytes.
+    const uint32_t trits = __builtin_amdgcn_perm(w1, w0, 0x07050301u);
+    return (int) __builtin_amdgcn_perm(0x000100FFu, 0x000100FFu, trits);
+}
+
+static __device__ __forceinline__ float vec_dot_ptq1_0_q8_1_hip(const void * __restrict__ vbq,
+                                                                const block_q8_1 * __restrict__ bq8_1,
+                                                                const int & kbx, const int & iqs) {
+    const block_ptq1_0 * bq = (const block_ptq1_0 *) vbq + kbx;
+    int sumi[4] = { 0, 0, 0, 0 };
+
+#pragma unroll
+    for (int g = 0; g < 4; ++g) {
+        const uint32_t packed = (uint32_t) get_int_b4(bq->qs, g);
+        uint32_t v0 = __builtin_amdgcn_perm(0u, packed, 0x04010400u);
+        uint32_t v1 = __builtin_amdgcn_perm(0u, packed, 0x04030402u);
+#pragma unroll
+        for (int t = 0; t < 5; ++t) {
+            const uint32_t w0 = v0 * 3;
+            const uint32_t w1 = v1 * 3;
+            v0 = w0 & 0x00FF00FF;
+            v1 = w1 & 0x00FF00FF;
+            const int e = t * 16 + 4 * g;
+            const int q8 = get_int_b4(bq8_1[iqs + (e >> 5)].qs, (e & 31) >> 2);
+            sumi[e >> 5] = ggml_cuda_dp4a(ptq1_0_pack_trits(w0, w1), q8, sumi[e >> 5]);
+        }
+    }
+
+#pragma unroll
+    for (int g = 0; g < 2; ++g) {
+        const uint32_t packed = (uint32_t) get_int_b4(bq->qs + 16, g);
+        uint32_t v0 = __builtin_amdgcn_perm(0u, packed, 0x04010400u);
+        uint32_t v1 = __builtin_amdgcn_perm(0u, packed, 0x04030402u);
+#pragma unroll
+        for (int t = 0; t < 5; ++t) {
+            const uint32_t w0 = v0 * 3;
+            const uint32_t w1 = v1 * 3;
+            v0 = w0 & 0x00FF00FF;
+            v1 = w1 & 0x00FF00FF;
+            const int e = 80 + t * 8 + 4 * g;
+            const int q8 = get_int_b4(bq8_1[iqs + (e >> 5)].qs, (e & 31) >> 2);
+            sumi[e >> 5] = ggml_cuda_dp4a(ptq1_0_pack_trits(w0, w1), q8, sumi[e >> 5]);
+        }
+    }
+
+    uint32_t v = (uint32_t) bq->qh[0] | ((uint32_t) bq->qh[1] << 16);
+#pragma unroll
+    for (int t = 0; t < 4; t += 2) {
+        const uint32_t w0 = v * 3;
+        v = w0 & 0x00FF00FF;
+        const uint32_t w1 = v * 3;
+        v = w1 & 0x00FF00FF;
+        const int q8 = get_int_b4(bq8_1[iqs + 3].qs, 6 + t / 2);
+        sumi[3] = ggml_cuda_dp4a(ptq1_0_pack_trits(w0, w1), q8, sumi[3]);
+    }
+
+    float acc = 0.0f;
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        acc += __low2float(bq8_1[iqs + k].ds) * (float) sumi[k];
+    }
+    return (float) bq->d * acc;
+}
